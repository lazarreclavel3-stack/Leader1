# --- Job sources (each is optional; unset sources are skipped) ---
# USAJOBS – federal jobs incl. Wage Grade trades. https://developer.usajobs.gov/APIRequest/Index
USAJOBS_API_KEY=
USAJOBS_EMAIL=
# Adzuna – large aggregator, free tier. https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us
# Jooble – large aggregator, free key on request. https://jooble.org/api/about
JOOBLE_API_KEY=
# CareerOneStop – US Dept. of Labor / National Labor Exchange (state job banks).
# https://www.careeronestop.org/Developers/WebAPI/registration.aspx
CAREERONESTOP_USER_ID=
CAREERONESTOP_TOKEN=
# Public employer boards, no key needed (comma-separated board/company slugs).
GREENHOUSE_BOARDS=doordashusa
LEVER_COMPANIES=

# --- Skynet ingest ---
SKYNET_INGEST_URL=
SKYNET_API_KEY=
