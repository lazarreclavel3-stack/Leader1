# Database
DATABASE_URL=postgresql://robo_cfo:password@localhost:5432/robo_cfo
DATABASE_POOL_SIZE=5

# Secrets (load from cloud secrets manager in production)
SECRET_KEY=your-secret-key-here-min-32-chars

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Plaid
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-secret
PLAID_ENV=sandbox

# QuickBooks Online
QBO_REALM_ID=your-realm-id
QBO_REDIRECT_URI=http://localhost:8000/auth/qbo/callback

# Stripe
STRIPE_RESTRICTED_API_KEY=rk_test_...

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=true
